---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { photos, type Photo } from '../data/photos';
import { byMonth } from '../data/colorSort';

/* 'date' = newest first; 'month' = newest month first, color-grouped within each month */
const ORDER: 'date' | 'month' = 'month';
const list = ORDER === 'month' ? await byMonth(photos) : photos;

/* two webps per photo for the lightbox: `full` fits the screen, `zoom` is every source pixel
   and only loads on zoom; i is the viewing order.
   w and h come from getImage, not from photo.src: reading a property of an imported image
   makes Astro ship the original file too */
const FIT = 2400;

type Item = { photo: Photo; i: number; full: string; zoom: string; w: number; h: number };
const items: Item[] = await Promise.all(
  list.map(async (photo, i) => {
    const zoom = await getImage({ src: photo.src, format: 'webp', quality: 85 });
    const full = await getImage({ src: photo.src, width: FIT, fit: 'inside', format: 'webp' });

    return {
      photo,
      i,
      full: full.src,
      zoom: zoom.src,
      w: Number(zoom.attributes.width),
      h: Number(zoom.attributes.height),
    };
  }),
);

/* Greedy shortest-column split, so order reads left to right at every column count. */
const split = (n: number) => {
  const cols = Array.from({ length: n }, () => ({ h: 0, items: [] as Item[] }));

  for (const item of items) {
    const col = cols.reduce((a, b) => (b.h < a.h ? b : a));
    col.items.push(item);
    col.h += item.h / item.w;
  }

  return cols.map((col) => col.items);
};

const layouts = [1, 2, 3].map((n) => ({ n, cols: split(n) }));
---

<Base
  title="Photos · David Huangal"
  description="Film and digital photography by David Huangal."
>
  <section class="intro">
    <h1>Photos</h1>
  </section>
  <section aria-label="Photographs" class="photo-wall">
    {
      layouts.map(({ n, cols }) => (
        <div class={`grid cols-${n}`}>
          {cols.map((col) => (
            <div class="col">
              {col.map(({ photo, i, full, zoom, w }) => (
                <figure>
                  <a class="open" href={full} data-i={i} data-zoom={zoom} data-w={w}>
                    <Image
                      src={photo.src}
                      alt={photo.alt}
                      widths={[640, 960, 1400, 1920]}
                      sizes="(min-width: 1280px) 28vw, (min-width: 900px) 38vw, 100vw"
                      loading="lazy"
                    />
                  </a>
                  {photo.caption && <figcaption>{photo.caption}</figcaption>}
                </figure>
              ))}
            </div>
          ))}
        </div>
      ))
    }
  </section>

  <dialog class="lightbox" aria-label="Photo viewer">
    <img alt="" />
  </dialog>

  <!-- inline so it runs before lazy images arrive; without JS, photos show unfaded -->
  <script is:inline>
    document.querySelectorAll('.photo-wall img').forEach((img) => {
      if (img.complete) return;

      img.classList.add('pending');
      const show = () => img.classList.remove('pending');
      img.addEventListener('load', show, { once: true });
      img.addEventListener('error', show, { once: true });
    });
  </script>

  <!-- lightbox: click opens full size; clicking the photo zooms in and out; clicking beside it
       or Esc closes; arrow keys step through, or scroll while zoomed.
       Zoom stops at the source's own pixels, so it never upscales; small sources don't zoom.
       The shown image only swaps once the next one is decoded, so nothing blanks. -->
  <script>
    const box = document.querySelector<HTMLDialogElement>('.lightbox')!;
    const view = box.querySelector('img')!;
    const links = [...document.querySelectorAll<HTMLAnchorElement>('.cols-1 a.open')];
    const ZOOM = 2.5;
    const MIN_ZOOM = 1.2;
    let at = 0;
    let token = 0;

    /* zoomed width in CSS px: one source pixel per device pixel, at most ZOOM times the fit */
    const zoomWidth = (fit: number) =>
      Math.min(fit * ZOOM, Number(links[at].dataset.w) / devicePixelRatio);

    const ratio = (img: HTMLImageElement) => {
      view.style.setProperty('--ar', String(img.naturalWidth / img.naturalHeight));
      if (box.classList.contains('zoomed')) return;

      const fit = view.getBoundingClientRect().width;
      box.classList.toggle('zoomable', zoomWidth(fit) >= fit * MIN_ZOOM);
    };

    const unzoom = () => {
      box.classList.remove('zoomed');
      view.style.width = '';
      box.scrollTo(0, 0);
    };

    /* zoom keeps the clicked point of the photo under the cursor */
    const zoom = (e: MouseEvent) => {
      const fit = view.getBoundingClientRect();
      const fx = (e.clientX - fit.left) / fit.width;
      const fy = (e.clientY - fit.top) / fit.height;

      if (box.classList.contains('zoomed')) return unzoom();
      if (!box.classList.contains('zoomable')) return;

      box.classList.add('zoomed');
      view.style.width = `${zoomWidth(fit.width)}px`;

      const big = view.getBoundingClientRect();
      box.scrollBy(big.left + fx * big.width - e.clientX, big.top + fy * big.height - e.clientY);

      /* the fit image is stretched for a moment; sharpen once every pixel has decoded */
      const t = token;
      const href = links[at].dataset.zoom!;

      preload(href).then(() => {
        if (t === token && box.classList.contains('zoomed')) view.src = href;
      });
    };

    const preload = (href: string) => {
      const img = new Image();
      img.src = href;
      return img.decode().catch(() => {});
    };

    const show = async (i: number) => {
      unzoom();
      at = (i + links.length) % links.length;
      const link = links[at];
      const t = ++token;

      await preload(link.href);
      if (t !== token) return;

      /* already zoomed on the thumbnail: the zoom image is on its way, don't swap under it */
      if (box.classList.contains('zoomed')) return;

      view.src = link.href;
      view.decode().then(() => t === token && ratio(view), () => {});
      view.alt = link.querySelector('img')?.alt ?? '';

      preload(links[(at + 1) % links.length].href);
      preload(links[(at - 1 + links.length) % links.length].href);
    };

    const close = () => {
      if (box.classList.contains('closing')) return;

      box.classList.add('closing');
      view.addEventListener(
        'animationend',
        () => {
          box.classList.remove('closing');
          box.close();
        },
        { once: true },
      );
    };

    document.querySelectorAll<HTMLAnchorElement>('.photo-wall a.open').forEach((link) => {
      link.addEventListener('click', (e) => {
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;

        e.preventDefault();

        /* the wall thumbnail is already loaded: show it now, sharpen when full size decodes */
        const thumb = link.querySelector('img');
        view.src = thumb?.currentSrc ?? '';
        view.alt = thumb?.alt ?? '';
        at = Number(link.dataset.i);
        if (thumb) ratio(thumb);
        unzoom();

        box.showModal();
        show(Number(link.dataset.i));
      });
    });

    box.addEventListener('click', (e) => (e.target === view ? zoom(e) : close()));

    box.addEventListener('cancel', (e) => {
      e.preventDefault();
      close();
    });

    box.addEventListener('keydown', (e) => {
      if (box.classList.contains('zoomed')) return;

      if (e.key === 'ArrowRight') show(at + 1);
      if (e.key === 'ArrowLeft') show(at - 1);
    });
  </script>
</Base>

<style is:global>
  /* keep the scrollbar's space when the lightbox locks scrolling, so the wall doesn't reflow */
  html {
    scrollbar-gutter: stable;
  }

  html:has(.lightbox[open]) {
    overflow: hidden;
  }
</style>

<style>
  /* wall: 1 / 2 / 3 columns, each rendered at build time so only one shows;
     square corners, no chrome, photos carry the page */
  .photo-wall {
    --wall-gap: 16px;
  }

  .grid {
    display: none;
    gap: var(--wall-gap);
    align-items: start;
  }

  .cols-1 {
    display: flex;
  }

  @media (min-width: 900px) {
    .photo-wall {
      --wall-gap: 24px;
    }

    .cols-1 {
      display: none;
    }

    .cols-2 {
      display: flex;
    }
  }

  @media (min-width: 1280px) {
    .cols-2 {
      display: none;
    }

    .cols-3 {
      display: flex;
    }
  }

  .col {
    flex: 1;
    min-width: 0;
    display: grid;
    gap: var(--wall-gap);
  }

  .col figure {
    margin: 0;
    display: grid;
    gap: 4px;
  }

  .col img {
    width: 100%;
    height: auto;
    transition: opacity 1000ms var(--ease-in-out);
  }

  .col img:global(.pending) {
    opacity: 0;
  }

  .col figcaption {
    font-size: var(--size-small);
  }

  .open {
    display: block;
    cursor: pointer;
  }

  /* full-viewport viewer: the page behind slowly blurs under a light paper tint */
  .lightbox {
    --lb-pad: max(var(--page-gutter), 5dvh);

    box-sizing: border-box;
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: hidden;
    cursor: default;
    container-type: size;
  }

  .lightbox[open] {
    display: flex;
  }

  .lightbox.zoomed {
    overflow: auto;
  }

  .lightbox::backdrop {
    background: color-mix(in srgb, var(--color-paper) 60%, transparent);
    backdrop-filter: blur(24px);
    animation: lb-blur 800ms var(--ease-in-out);
  }

  .lightbox.closing::backdrop {
    animation: lb-unblur 500ms var(--ease-in-out) forwards;
  }

  /* sized to the photo itself, as large as fits inside --lb-pad, so clicks beside it miss it.
     The pad is in the math, not on the dialog: Firefox keeps stale cq units when padding changes.
     --ar is set from the image; auto margins center it and stay scrollable when zoomed */
  .lightbox img {
    flex: none;
    width: min(100cqw - 2 * var(--lb-pad), (100cqh - 2 * var(--lb-pad)) * var(--ar, 1.5));
    aspect-ratio: var(--ar, 1.5);
    margin: auto;
    animation: lb-fade 500ms var(--ease-in-out);
  }

  .lightbox.zoomable img {
    cursor: zoom-in;
  }

  .lightbox.zoomed img {
    cursor: zoom-out;
  }

  .lightbox.closing img {
    animation: lb-fadeout 500ms var(--ease-in-out) forwards;
  }

  @keyframes lb-blur {
    from {
      background: transparent;
      backdrop-filter: blur(0);
    }
  }

  @keyframes lb-unblur {
    to {
      background: transparent;
      backdrop-filter: blur(0);
    }
  }

  @keyframes lb-fade {
    from {
      opacity: 0;
    }
  }

  @keyframes lb-fadeout {
    to {
      opacity: 0;
    }
  }
</style>

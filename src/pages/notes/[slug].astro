---
import { getCollection, render } from 'astro:content';
import 'katex/dist/katex.min.css';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map((note) => ({ params: { slug: note.id }, props: { note } }));
}

const { note } = Astro.props;
const { Content } = await render(note);

const topicLabel = {
  'semantic-segmentation': 'Semantic Segmentation',
  'object-detection': 'Object Detection',
}[note.data.topic];
const dateFmt = new Intl.DateTimeFormat('en-US', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<Base
  title={`${note.data.title} · Paper Notes · David Huangal`}
  description={note.data.description}
>
  <article>
    <header class="note-head">
      <h1>{note.data.title}</h1>
      <p class="paper-title">
        {note.data.paperTitle}
        {note.data.paperAuthors && <span class="authors"> — {note.data.paperAuthors}</span>}
      </p>
      <p class="note-meta">
        Paper {note.data.paperYear} · {topicLabel} · Notes,{' '}
        <time datetime={note.data.date.toISOString()}>{dateFmt.format(note.data.date)}</time>
      </p>
    </header>
    <div class="prose">
      <Content />
    </div>
    <p class="link-cta back"><a href="/notes/">← All paper notes</a></p>
  </article>
</Base>

<style>
  .note-head {
    max-width: 640px;
    margin-bottom: 32px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--rule);
  }

  .note-head h1 {
    margin-bottom: 8px;
  }

  .note-meta {
    margin-top: 8px;
    font-size: var(--size-small);
  }

  .back {
    margin-top: 64px;
  }
</style>

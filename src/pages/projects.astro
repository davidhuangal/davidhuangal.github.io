---
import Base from '../layouts/Base.astro';
import { projects } from '../data/projects';
---

<Base
  title="Projects · David Huangal"
  description="Open-source projects by David Huangal: vision-language model evaluation for remote sensing and segmentation model ports for MMSegmentation."
>
  <section aria-labelledby="h-projects">
    <header class="head-hang">
      <h2 id="h-projects">Projects</h2>
    </header>
    <ul class="index-list">
      {
        projects.map((project) => (
          <li>
            <div class="project">
              <p class="project-name">
                <a href={project.url}>{project.name}</a>
                <span class="index-meta mono">{project.meta}</span>
              </p>
              <p class="project-desc">{project.description}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .project {
    padding-block: var(--space-md);
    max-width: var(--measure);
  }

  .project p {
    margin: 0;
  }

  .project-name {
    display: flex;
    align-items: baseline;
    gap: var(--space-md);
    margin-bottom: var(--space-2xs);
  }

  .project-name a {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-md);
    color: var(--color-ink);
    text-decoration: none;
  }

  .project-name a:hover {
    color: var(--color-accent);
  }

  .project-name .index-meta {
    font-size: var(--text-xs);
    color: var(--color-neutral);
  }

  .project-desc {
    font-size: var(--text-sm);
    color: var(--color-muted);
    line-height: 1.55;
  }
</style>

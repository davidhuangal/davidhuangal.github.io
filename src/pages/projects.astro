---
import Base from '../layouts/Base.astro';
import { projects } from '../data/projects';
---

<Base
  title="Projects · David Huangal"
  description="Open-source projects by David Huangal: vision-language model evaluation for remote sensing and segmentation model ports for MMSegmentation."
>
  <section class="intro" aria-labelledby="h-projects">
    <h1 id="h-projects">Projects</h1>
    <ul class="doc-list">
      {
        projects.map((project) => (
          <li>
            <a href={project.url}>{project.name}</a>
            <span class="meta muted"> · {project.meta}</span>
            <span class="sub-line">{project.description}</span>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  /* Hallmark · design-system: design.md · designed-as-app */
  .intro {
    padding-top: var(--space-xl);
    max-width: var(--measure);
  }

  .intro h1 {
    margin-bottom: var(--space-md);
  }

  .meta {
    font-size: var(--text-sm);
  }
</style>

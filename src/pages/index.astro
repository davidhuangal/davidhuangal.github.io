---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import portrait from '../assets/david.jpg';
import { photos } from '../data/photos';

const CARD_W = 840;

const toCard = async (src: ImageMetadata, alt: string) => {
  const img = await getImage({ src, width: Math.min(CARD_W, src.width), format: 'webp' });

  return { src: img.src, w: src.width, h: src.height, alt };
};

const first = await toCard(portrait, 'David Huangal smiling in a garden');
const cards = await Promise.all(photos.map((photo) => toCard(photo.src, photo.alt)));
const deck = JSON.stringify(cards).replace(/</g, '\\u003c');

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'David Huangal',
  url: 'https://davidhuangal.github.io/',
  image: new URL(portrait.src, Astro.site).href,
  jobTitle: 'Senior Research Specialist',
  worksFor: {
    '@type': 'Organization',
    name: "University of Missouri Center for Geospatial Intelligence",
  },
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'University of Missouri - Columbia',
  },
  email: 'mailto:davidbhuangal@gmail.com',
  sameAs: [
    'https://github.com/davidhuangal',
    'https://scholar.google.com/citations?user=C8obXZcAAAAJ',
    'https://www.linkedin.com/in/david-huangal/',
    'https://davidhuangal.bearblog.dev/',
  ],
};
---

<Base
  home
  title="David Huangal"
  description="David Huangal - Applied Scientist at the University of Missouri's Center for Geospatial Intelligence. Paper notes, publications, and projects on semantic segmentation and remote sensing."
>
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} is:inline />

  <h1>Hi, my name is David Huangal.</h1>

  <figure class="stage">
    <img class="card" src={first.src} alt={first.alt} width={first.w} height={first.h} />
  </figure>

  <div class="statement">
    <p>
      I work as an applied scientist in computer vision at the University of Missouri's Center for
      Geospatial Intelligence, where my official appointment is Senior Research Specialist.
    </p>
    <p>
      My work focuses on building accurate, efficient AI systems that operate at scale. Much of my
      research has involved classification, segmentation, and object detection in satellite and
      aerial imagery, and my broader interests include vision-language models, model evaluation,
      and machine learning deployment.
    </p>
    <p>
      I earned both my bachelor's degree and Ph.D. in Computer Science from the University of
      Missouri - Columbia.
    </p>
    <p>
      Here you can find my <a href="/publications/">publications</a>,
      <a href="/projects/">projects</a>, <a href="/notes/">paper notes</a>, and
      <a href="/photos/">photographs</a>.
    </p>
  </div>

  <script type="application/json" id="deck" set:html={deck} />

  <!-- the sidebar's shuffle button swaps in a random photo once it has loaded -->
  <script>
    interface Card {
      src: string;
      w: number;
      h: number;
      alt: string;
    }

    const deck: Card[] = JSON.parse(document.getElementById('deck')!.textContent!);
    const stage = document.querySelector<HTMLElement>('.stage')!;
    const image = stage.querySelector('img')!;
    const shuffle = document.querySelector<HTMLButtonElement>('.shuffle')!;

    const pick = <T,>(items: T[], last?: T) => {
      let item = items[Math.floor(Math.random() * items.length)];

      while (items.length > 1 && item === last) {
        item = items[Math.floor(Math.random() * items.length)];
      }

      return item;
    };

    let photo: Card | undefined;

    const deal = () => {
      const next = (photo = pick(deck, photo));
      const loader = new Image();

      stage.classList.add('is-loading');

      loader.onload = () => {
        image.src = next.src;
        image.alt = next.alt;
        image.width = next.w;
        image.height = next.h;
        stage.classList.remove('is-loading');
      };

      loader.onerror = () => stage.classList.remove('is-loading');
      loader.src = next.src;
    };

    shuffle.addEventListener('click', deal);
  </script>
</Base>

<style>
  /* text left, photo right; the photo takes the height of the text column */
  :global(main.home) {
    display: grid;
    grid-template-columns: minmax(0, 560px) minmax(0, 420px);
    grid-template-areas:
      'hello card'
      'text  card'
      'legal card';
    gap: 24px clamp(32px, 6vw, 96px);
    align-items: start;
  }

  :global(main.home .legal) {
    grid-area: legal;
    margin-top: 24px;
  }

  h1 {
    grid-area: hello;
    margin: 0;
    letter-spacing: 0.02em;
    text-transform: none;
  }

  .statement {
    grid-area: text;
  }

  .statement p + p {
    margin-top: 1em;
  }

  .stage {
    position: relative;
    grid-area: card;
    align-self: stretch;
    transition: opacity 140ms var(--ease-out);
  }

  .stage:global(.is-loading) {
    opacity: 0.38;
  }

  /* out of flow, so the text sets the row height and the photo matches it */
  .card {
    position: absolute;
    top: 0;
    left: 0;
    width: auto;
    height: 100%;
    max-width: 100%;
    object-fit: cover;
  }

  :global(.shuffle) {
    all: unset;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--paper);
    cursor: pointer;
    transition: transform 140ms var(--ease-out);
  }

  :global(.shuffle:active) {
    transform: scale(0.94);
  }

  :global(.shuffle:focus-visible) {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }

  :global(.shuffle svg) {
    width: 13px;
    height: 13px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.25;
    stroke-linecap: square;
  }

  @media (max-width: 1180px) {
    :global(main.home) {
      grid-template-columns: minmax(0, 560px);
      grid-template-areas:
        'hello'
        'card'
        'text'
        'legal';
    }

    .stage {
      width: min(100%, 420px);
    }

    .card {
      position: static;
      display: block;
      width: 100%;
      height: auto;
    }
  }
</style>

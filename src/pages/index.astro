---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { publications } from '../data/publications';
import { projects } from '../data/projects';

const notes = (await getCollection('notes')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const recentNotes = notes
  .slice(0, 5)
  .sort((a, b) => b.data.paperYear - a.data.paperYear);
const selected = publications.filter((p) => p.selected).sort((a, b) => b.year - a.year);
---

<Base
  title="David Huangal"
  description="David Huangal — AI researcher and technical lead at the University of Missouri's Center for Geospatial Intelligence. Paper notes, publications, and projects on semantic segmentation and remote sensing."
>
  <section class="intro">
    <figure class="portrait-fig">
      <img
        class="portrait"
        src="/images/david.jpg"
        alt="David Huangal smiling in a garden"
        width="522"
        height="760"
        loading="eager"
        decoding="async"
      />
      <figcaption class="muted">Kodak Ultramax 400</figcaption>
    </figure>
    <div class="intro-text">
      <h1>David Huangal</h1>
      <p class="tagline muted">Applied AI · Remote Sensing · University of Missouri</p>
      <p>
        I'm an AI researcher and technical lead at the University of Missouri's Center for
        Geospatial Intelligence. My work focuses on computer vision and building accurate,
        efficient AI systems that operate at scale. Much of my research has involved semantic
        segmentation and object detection in satellite and aerial imagery, and my broader
        interests include vision-language models, model evaluation, and machine learning
        deployment.
      </p>
      <p>
        I earned both my bachelor's degree and Ph.D. in Computer Science from the University of
        Missouri - Columbia.
      </p>
      <p>
        You can find me on GitHub at <a href="https://github.com/davidhuangal">davidhuangal</a> or
        connect with me on
        <a href="https://www.linkedin.com/in/david-huangal-b447a314b/">LinkedIn</a>.
      </p>
    </div>
  </section>

  <hr />

  <section aria-labelledby="h-pubs">
    <h2 id="h-pubs">Selected Publications</h2>
    <ul class="doc-list">
      {
        selected.map((pub) => (
          <li>
            <span class="tnum">[{pub.year}]</span> <a href={pub.url}>{pub.title}</a>
            <span class="sub-line">
              {pub.authors.map((author, i) => (
                <>
                  {i > 0 && ', '}
                  {author === 'David Huangal' ? <strong>{author}</strong> : author}
                </>
              ))}
            </span>
            <span class="sub-line venue">{pub.venue}</span>
          </li>
        ))
      }
    </ul>
    <p class="link-cta"><a href="/publications/">All {publications.length} publications →</a></p>
  </section>

  <hr />

  <section aria-labelledby="h-projects">
    <h2 id="h-projects">Projects</h2>
    <ul class="doc-list">
      {
        projects.map((project) => (
          <li>
            <a href={project.url}>{project.name}</a>
            <span class="meta muted"> · {project.meta}</span>
            <span class="sub-line">{project.description}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <hr />

  <section aria-labelledby="h-notes">
    <h2 id="h-notes">Paper Notes</h2>
    <ul class="doc-list">
      {
        recentNotes.map((note) => (
          <li>
            <span class="tnum">[{note.data.paperYear}]</span>{' '}
            <a href={`/notes/${note.id}/`}>{note.data.title}</a>
          </li>
        ))
      }
    </ul>
    <p class="link-cta"><a href="/notes/">All {notes.length} notes, by topic →</a></p>
  </section>
</Base>

<style>
  /* Hallmark · design-system: design.md · designed-as-app */
  /* split diptych: bio left, portrait right; stacks with the photo on top on mobile */
  .intro {
    padding-top: var(--space-xl);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-lg);
  }

  .portrait-fig {
    margin: 0;
    flex-shrink: 0;
    display: grid;
    gap: var(--space-2xs);
    justify-items: center;
  }

  .portrait {
    width: 12rem;
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-card);
  }

  .portrait-fig figcaption {
    font-size: var(--text-xs);
  }

  .intro-text {
    flex: 1;
    min-width: 0;
    max-width: var(--measure);
  }

  .intro h1 {
    margin-bottom: var(--space-2xs);
  }

  .tagline {
    margin: 0 0 var(--space-md);
    font-size: var(--text-sm);
  }

  .intro-text p:not(.tagline) {
    margin: 0 0 var(--space-md);
  }

  .intro-text p:last-child {
    margin-bottom: 0;
  }

  .meta {
    font-size: var(--text-sm);
  }

  .sub-line strong {
    color: var(--color-ink);
    font-weight: 600;
  }

  .venue {
    font-size: var(--text-xs);
  }

  @media (min-width: 640px) {
    .intro {
      flex-direction: row-reverse;
      align-items: flex-start;
      gap: var(--space-xl);
    }

    .portrait-fig {
      margin-top: var(--space-sm);
    }

    .portrait {
      width: 13rem;
    }
  }
</style>

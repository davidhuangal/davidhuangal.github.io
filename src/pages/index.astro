---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { publications } from '../data/publications';
import { projects } from '../data/projects';

const notes = (await getCollection('notes')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const recentNotes = notes
  .slice(0, 5)
  .sort((a, b) => b.data.paperYear - a.data.paperYear);
const firstAuthor = publications.filter((p) => p.firstAuthor);
---

<Base
  title="David Huangal"
  description="David Huangal — applied AI researcher at the University of Missouri. Paper notes, publications, and projects on semantic segmentation and remote sensing."
>
  <section class="intro">
    <figure class="portrait-fig">
      <img
        class="portrait"
        src="/images/david.jpg"
        alt="David Huangal smiling in a garden"
        width="522"
        height="760"
        loading="eager"
        decoding="async"
      />
      <figcaption class="muted">Kodak Ultramax 400</figcaption>
    </figure>
    <div class="intro-text">
      <h1>David Huangal</h1>
      <p class="tagline muted">Applied AI · Remote Sensing · University of Missouri</p>
      <p>
        I am a researcher at the University of Missouri, Columbia working on applied AI. I'm
        particularly interested in developing methods that are both accurate and computationally
        efficient, enabling them to scale to the large volumes of data common to modern
        applications.
      </p>
    </div>
  </section>

  <hr />

  <section aria-labelledby="h-pubs">
    <h2 id="h-pubs">First-Author Publications</h2>
    <ul class="doc-list">
      {
        firstAuthor.map((pub) => (
          <li>
            <span class="tnum">[{pub.year}]</span> <a href={pub.url}>{pub.title}</a>
            <span class="sub-line">
              {pub.authors.map((author, i) => (
                <>
                  {i > 0 && ', '}
                  {author === 'David Huangal' ? <strong>{author}</strong> : author}
                </>
              ))}
            </span>
            <span class="sub-line venue">{pub.venue}</span>
          </li>
        ))
      }
    </ul>
    <p class="link-cta"><a href="/publications/">All {publications.length} publications →</a></p>
  </section>

  <hr />

  <section aria-labelledby="h-projects">
    <h2 id="h-projects">Projects</h2>
    <ul class="doc-list">
      {
        projects.map((project) => (
          <li>
            <a href={project.url}>{project.name}</a>
            <span class="meta muted"> · {project.meta}</span>
            <span class="sub-line">{project.description}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <hr />

  <section aria-labelledby="h-notes">
    <h2 id="h-notes">Paper Notes</h2>
    <ul class="doc-list">
      {
        recentNotes.map((note) => (
          <li>
            <span class="tnum">[{note.data.paperYear}]</span>{' '}
            <a href={`/notes/${note.id}/`}>{note.data.title}</a>
          </li>
        ))
      }
    </ul>
    <p class="link-cta"><a href="/notes/">All {notes.length} notes, by topic →</a></p>
  </section>
</Base>

<style>
  /* Hallmark · design-system: design.md · designed-as-app */
  /* split diptych: bio left, portrait right; stacks with the photo on top on mobile */
  .intro {
    padding-top: var(--space-xl);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-lg);
  }

  .portrait-fig {
    margin: 0;
    flex-shrink: 0;
    display: grid;
    gap: var(--space-2xs);
    justify-items: center;
  }

  .portrait {
    width: 12rem;
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-card);
  }

  .portrait-fig figcaption {
    font-size: var(--text-xs);
  }

  .intro-text {
    flex: 1;
    min-width: 0;
    max-width: var(--measure);
  }

  .intro h1 {
    margin-bottom: var(--space-2xs);
  }

  .tagline {
    margin: 0 0 var(--space-md);
    font-size: var(--text-sm);
  }

  .intro-text p:not(.tagline) {
    margin: 0;
  }

  .meta {
    font-size: var(--text-sm);
  }

  .sub-line strong {
    color: var(--color-ink);
    font-weight: 600;
  }

  .venue {
    font-size: var(--text-xs);
  }

  @media (min-width: 640px) {
    .intro {
      flex-direction: row-reverse;
      align-items: flex-start;
      gap: var(--space-xl);
    }

    .portrait-fig {
      margin-top: var(--space-sm);
    }

    .portrait {
      width: 13rem;
    }
  }
</style>

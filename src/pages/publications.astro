---
import Base from '../layouts/Base.astro';
import { publications } from '../data/publications';

const firstAuthor = publications.filter((p) => p.firstAuthor);
const coAuthor = publications.filter((p) => !p.firstAuthor);

const sections = [
  { heading: 'First-Author', pubs: firstAuthor },
  { heading: 'Co-Author', pubs: coAuthor },
];
---

<Base
  title="Publications · David Huangal"
  description="Publications by David Huangal on semantic segmentation, remote sensing, and UAS imagery analysis, in IEEE, SPIE, and MDPI venues."
>
  {
    sections.map((section) => (
      <section aria-labelledby={`h-${section.heading.toLowerCase()}`}>
        <header class="head-hang">
          <h2 id={`h-${section.heading.toLowerCase()}`}>
            {section.heading} <span class="count tnum">({section.pubs.length})</span>
          </h2>
        </header>
        <ol class="index-list pub-list">
          {section.pubs.map((pub) => (
            <li>
              <div class="pub">
                <p class="pub-title">
                  <a href={pub.url}>{pub.title}</a>
                </p>
                <p class="pub-authors">
                  {pub.authors.map((author, i) => (
                    <>
                      {i > 0 && ', '}
                      {author === 'David Huangal' ? <strong>{author}</strong> : author}
                    </>
                  ))}
                </p>
                <p class="pub-venue mono">
                  <span class="tnum">{pub.year}</span> · {pub.venue}
                </p>
              </div>
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</Base>

<style>
  .count {
    color: var(--color-neutral);
    font-weight: 400;
  }

  .pub {
    padding-block: var(--space-md);
    max-width: var(--measure);
  }

  .pub p {
    margin: 0;
  }

  .pub-title {
    font-size: var(--text-md);
    line-height: 1.35;
    margin-bottom: var(--space-2xs);
  }

  .pub-title a {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--color-ink);
    text-decoration: none;
  }

  .pub-title a:hover {
    color: var(--color-accent);
  }

  .pub-authors {
    font-size: var(--text-sm);
    color: var(--color-neutral);
    line-height: 1.5;
    margin-bottom: var(--space-2xs);
  }

  .pub-authors strong {
    color: var(--color-ink);
    font-weight: 600;
  }

  .pub-venue {
    font-size: var(--text-xs);
    color: var(--color-neutral);
    letter-spacing: 0.02em;
  }
</style>

---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found · David Huangal" description="This page does not exist.">
  <section class="notfound">
    <h1>Page not found.</h1>
    <p>This address doesn't match anything on the site.</p>
    <p class="link-cta"><a href="/">Back to the index →</a></p>
  </section>
</Base>

<style>
  .notfound {
    max-width: var(--col);
  }

  .notfound p + p {
    margin-top: 1em;
  }
</style>
